# Copy to .env.local. Never commit real values.

# Claude evaluation. Without it, scans still run and score with keyword pre-screening only.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Cost controls
MAX_EVALUATIONS_PER_SCAN=15
MIN_PRESCORE_FOR_EVALUATION=40

# Optional: password-protect the dashboard (HTTP Basic auth, any username).
DASHBOARD_PASSWORD=

# Optional: protects POST /api/scan when called by a scheduler (send "Authorization: Bearer <value>").
CRON_SECRET=

# Optional: protects the MCP endpoint (/api/mcp). Claude connects with ?key=<value> or a Bearer header.
MCP_ACCESS_KEY=
